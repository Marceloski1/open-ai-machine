{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-machine-ai/registry/schema.json",
  "definitions": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description",
        "commands",
        "agents",
        "skills",
        "templates",
        "dependencies",
        "externalRequirements",
        "permissions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^machine-[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-.]+)?(\\+[0-9A-Za-z-.]+)?$"
        },
        "target": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^machine-[a-z0-9-]+$"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "object"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "node",
            "python"
          ]
        }
      }
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description",
        "commands",
        "agents",
        "skills",
        "templates",
        "compatibility",
        "checksum",
        "permissions",
        "externalRequirements",
        "packageDir",
        "runtime",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compatibility": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "permissions": {
          "type": "object"
        },
        "externalRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "type": "string",
          "enum": [
            "node",
            "python"
          ]
        },
        "packageDir": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/catalogEntry"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/manifest"
    },
    {
      "$ref": "#/definitions/catalog"
    }
  ]
}
